# Exclude all top-level hidden directories by convention
/.*/

# Exclude tarballs generated by `npm pack`
/*.tgz

# Testing files
__mocks__
__tests__
/ios/Tests/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx

# Config files not needed in published package
/babel.config.js
/.eslintrc.js
/tsconfig.json

# Android test directories
/android/src/androidTest/
/android/src/test/
/android/build/

# iOS test directories
/ios/Tests/
/ios/*.xcodeproj/
/ios/*.xcworkspace/

# Example app - completely excluded from npm package
/example/

# Documentation files (keep README.md)
/SECURITY_REVIEW.md
/CONTRIBUTING.md

# GitHub specific files
/.github/
/.gitignore

# Development files
/node_modules/
/coverage/
/.vscode/
/.idea/
*.log
.DS_Store

# Build artifacts that shouldn't be published
/build/types/

# Source maps (if any)
*.map
